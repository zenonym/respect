# Add the Discord webhook URL from Server Settings > Integrations > Webhooks.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/000000000000000000/replace-with-your-webhook-token

# JSON array of users who can appear in the dropdown.
RESPECT_USERS=[{"id":"123456789012345678","name":"Alex"},{"id":"234567890123456789","name":"Sam"}]
